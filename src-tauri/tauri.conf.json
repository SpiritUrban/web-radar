{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Web Radar",
    "version":  "0.2.0",
    "identifier":  "com.webradar.desktop",
    "build":  {
                  "beforeDevCommand":  "npm run dev:frontend",
                  "devUrl":  "http://localhost:1422",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Web Radar",
                                    "width":  1280,
                                    "height":  820,
                                    "minWidth":  960,
                                    "minHeight":  680,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "center":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "resources":  {
                                     "../config.toml":  "config.toml"
                                 }
               }
}