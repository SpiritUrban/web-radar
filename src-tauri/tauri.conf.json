{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Web Radar",
  "version": "0.3.0",
  "identifier": "io.github.spiriturban.webradar",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Web Radar",
        "width": 1360,
        "height": 860,
        "minWidth": 1020,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SpiritUrban/web-radar/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Vitaliy Dyachuk",
    "copyright": "© 2026 Vitaliy Dyachuk",
    "category": "DeveloperTool",
    "shortDescription": "Common Crawl domain graph explorer",
    "longDescription": "Web Radar answers who links to a domain and where it links to, from the Common Crawl domain-level web graph, entirely on your machine.",
    "homepage": "https://spiriturban.github.io/web-radar/",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "../config.toml": "config.toml"
    }
  }
}
