{
    "name": "web-radar-desktop",
    "private": true,
    "version": "0.3.0",
    "type": "module",
    "description": "Common Crawl domain graph explorer — who links to a domain, answered locally",
    "author": "Vitaliy Dyachuk (https://spiriturban.github.io/)",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/SpiritUrban/web-radar.git"
    },
    "scripts": {
        "start": "tauri dev",
        "dev": "tauri dev",
        "tauri:dev": "tauri dev",
        "build": "tsc && vite build",
        "dev:frontend": "vite",
        "test": "vitest run",
        "tauri": "tauri",
        "build:site": "vite build --config site/vite.config.ts",
        "dev:site": "vite --config site/vite.config.ts",
        "version:sync": "node scripts/sync-version.mjs",
        "version:check": "node scripts/check-version.mjs",
        "manifest": "node scripts/generate-download-manifest.mjs"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.8.0",
        "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
        "@tauri-apps/plugin-dialog": "^2.4.0",
        "@tauri-apps/plugin-opener": "^2.5.0",
        "@tauri-apps/plugin-process": "^2.3.0",
        "@tauri-apps/plugin-updater": "^2.9.0",
        "lucide-react": "^0.468.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "zustand": "^5.0.2"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.8.4",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.5.1",
        "tailwindcss": "^3.4.17",
        "typescript": "~5.7.2",
        "vite": "^6.0.5",
        "vitest": "^2.1.8"
    }
}
